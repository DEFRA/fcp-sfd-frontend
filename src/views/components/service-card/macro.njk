{#
  Example usage:

  {% from "components/service-card/macro.njk" import serviceCard %}

  {{ serviceCard({
    cards: [{
      title: "Farm Payments Technical Test",
      status: 'not-started',
      link: "fp-check-your-details"
    }]
  }) }}
#}

{% macro serviceCard(params) %}

<div class="service-card custom-cards-margin">
  <div class="govuk-grid-column-two-thirds">
    <ul class="service-card__list service-card__list-cards">
      {% for card in params.cards %}
      <li class="service-card__list-item-variant">
        <div class="service-card__list-item-wrapper-variant">
          <h3 class="govuk-heading-s">
            {{ card.title }}
          </h3>

          {# Only show status if not 'do-not-show' #}
          {% if card.status != 'do-not-show' %}
            <p class="govuk-body">
              <strong class="govuk-tag{% if card.status == 'not-started' %} govuk-tag--grey{% endif %}">
                {% if card.status == 'not-started' %}
                  Not started
                {% else %}
                  In progress
                {% endif %}
              </strong>
            </p>

            <a href="{{ card.link }}" class="govuk-link govuk-link--no-visited-state service-card__link">
              {% if card.status == 'not-started' %}
                Start application
              {% else %}
                Continue application
              {% endif %}
            </a>
          {% else %}
            <a href="{{ card.link }}" class="govuk-link govuk-link--no-visited-state service-card__link">
              Go to application
            </a>
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% endmacro %}

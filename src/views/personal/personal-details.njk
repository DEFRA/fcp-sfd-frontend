{% extends 'common/layout.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "common/navigation/back-sign-out-link.njk" import appBackSignOutLink with context %}

{% block beforeContent %}
  {{ appBackSignOutLink(backLink) }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
      {# Notification banner #}
      {% if notification %}
        {% if notification.html %}
          {{ govukNotificationBanner({
            type: "success",
            titleText: notification.title,
            html: notification.html
          })}}
        {% else %}
          {{ govukNotificationBanner({
            type: "success",
            titleText: notification.title,
            text: notification.text
          })}}
        {% endif %}
      {% endif %}

      {# Update disabled warning #}
      {% if updateDisabledWarning %}
        {{ govukNotificationBanner({
          type: "warning",
          titleText: updateDisabledWarning.title,
          text: updateDisabledWarning.text
        })}}
      {% endif %}

    <span class="govuk-caption-l text-wrap-no-hyphen">{{userName}}</span>

    <h1 class="govuk-heading-l">
      View and update your personal details
    </h1>

    {% set displayDOB %}
      {% if dob.fullDateOfBirth === notAddedText %}
        <div><span class="govuk-hint display-inline">{{ notAddedText }}</span></div>
      {% else %}
        <div>{{ dob.fullDateOfBirth }}</div>
      {% endif %}
    {% endset %}

    {% set formattedAddress %}
      {% if personalAddress.address === notAddedText %}
        <div><span class="govuk-hint display-inline">{{ notAddedText }}</span></div>
      {% else %}
        {% for addressLine in personalAddress.address %}
          <div>{{addressLine}}</div>
        {% endfor %}
      {% endif %}
    {% endset %}

    {% set displayPersonalTelephone %}
      <div>
        Telephone:
        {% if personalTelephone.telephone === notAddedText %}
          <span class="govuk-hint display-inline">{{ personalTelephone.telephone }}</span>
        {% else %}
          <span>{{ personalTelephone.telephone }}</span>
        {% endif %}
      </div>
      <div>
        Mobile:
        {% if personalTelephone.mobile === notAddedText %}
          <span class="govuk-hint display-inline">{{ personalTelephone.mobile }}</span>
        {% else %}
          <span>{{ personalTelephone.mobile }}</span>
        {% endif %}
      </div>
    {% endset %}

    {% set displayPersonalEmail %}
      {% if personalEmail.email === notAddedText %}
        <div><span class="govuk-hint display-inline">{{ notAddedText }}</span></div>
      {% else %}
        <div>{{ personalEmail.email }}</div>
      {% endif %}
    {% endset %}

    {# Set change links #}
    {% if personalName.changeLink %}
      {% set personalNameActions = {
        items: [
          {
            href: personalName.changeLink,
            text: personalName.action,
            visuallyHiddenText: "Full name",
            classes: "govuk-link--no-visited-state"
          }
        ]
      } %}
    {% else %}
      {% set personalNameActions = null %}
    {% endif %}

    {% if dob.changeLink %}
      {% set dobActions = {
        items: [
          {
            href: dob.changeLink,
            text: dob.action,
            visuallyHiddenText: "date of birth",
            classes: "govuk-link--no-visited-state"
          }
        ]
      } %}
    {% else %}
      {% set dobActions = null %}
    {% endif %}

    {% if personalAddress.changeLink %}
      {% set personalAddressActions = {
        items: [
          {
            href: personalAddress.changeLink,
            text: personalAddress.action,
            visuallyHiddenText: "personal address",
            classes: "govuk-link--no-visited-state"
          }
        ]
      } %}
    {% else %}
      {% set personalAddressActions = null %}
    {% endif %}

    {% if personalTelephone.changeLink %}
      {% set personalTelephoneActions = {
        items: [
          {
            href: personalTelephone.changeLink,
            text: personalTelephone.action,
            visuallyHiddenText: "personal phone numbers",
            classes: "govuk-link--no-visited-state"
          }
        ]
      } %}
    {% else %}
      {% set personalTelephoneActions = null %}
    {% endif %}

    {% if personalEmail.changeLink %}
      {% set personalEmailActions = {
        items: [
          {
            href: personalEmail.changeLink,
            text: personalEmail.action,
            visuallyHiddenText: "personal email address",
            classes: "govuk-link--no-visited-state"
          }
        ]
      } %}
    {% else %}
      {% set personalEmailActions = null %}
    {% endif %}

    {{ govukSummaryList({
      rows: [
        {
          key: {
            text: "Full name"
          },
          value: {
            text: personalName.fullName
          },
          actions: personalNameActions
        },
        {
          key: {
            text: "Date of birth"
          },
          value: {
            html: displayDOB
          },
          actions: dobActions
        },
        {
          key: {
            text: "Customer reference number"
          },
          value: {
            text: crn
          }
        },
        {
          key: {
            text: "Personal address"
          },
          value: {
            html: formattedAddress
          },
          actions: personalAddressActions
        },
        {
          key: {
            text: "Personal phone numbers"
          },
          value: {
            html: displayPersonalTelephone
          },
          actions: personalTelephoneActions
        },
        {
          key: {
            text: "Personal email address"
          },
          value: {
            html: displayPersonalEmail
          },
          actions: personalEmailActions
        }
      ]
    }) }}

  </div>
</div>
{% endblock %}

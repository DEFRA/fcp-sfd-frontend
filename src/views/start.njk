{% extends 'common/layout.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Start using the Farm and Land Service</h1>
      <p class="govuk-body">Use the Farm and Land Service to:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>update your personal details</li>
        <li>update your business details</li>
        <li>apply for certain grants, if we have invited you</li>
      </ul>
      <p class="govuk-body">You’ll need your Rural Payments service customer reference number (CRN) and password to sign in.</p>

      {{ govukButton({
        text: "Start now",
        href: "/auth/sign-in",
        isStartButton: true,
        preventDoubleClick: true
      }) }}

      <h2 class="govuk-heading-l">What the Farm and Land Service is</h2>
      <p class="govuk-body">The Farm and Land Service is being developed to make it easier for people to manage their account with the Rural Payments Agency.</p>

      <p class="govuk-body">At the moment, you can only use the Farm and Land Service to:</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>
          update some of your account information
        </li>
        <li>
          apply for certain grants, if we have invited you
        </li>
      </ul>

      <p class="govuk-body">Over time, we intend to develop this service further.</p>
      <p class="govuk-body">This service is currently being tested by a small group of people. You should only use it if we have invited you.</p>
    </div>
  </div>

{% endblock %}
